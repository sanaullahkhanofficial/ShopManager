# Copy to .env for local server testing (server.cjs reads process.env directly,
# no dotenv loader is bundled — export these or use your host's env var settings).

# Where the SQLite database, backups and uploads are stored. Must point at a
# persistent volume/disk on your hosting provider, or all data is lost on restart.
DATA_DIR=./data

# Port the Express server listens on. Most hosting providers set this for you.
PORT=3000

# Long random string used to sign session cookies. MUST be set to a stable
# value in production — if it changes (or is left unset, which generates a
# random one at each boot) everyone is signed out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set by most hosting providers automatically; controls secure-cookie behavior.
NODE_ENV=production
