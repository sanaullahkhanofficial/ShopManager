{
  "name": "shopmanager-desktop",
  "version": "1.26.0",
  "description": "Haji Abdul Manan & Abdul Hanan — Atta Dealer Pishin: offline-first Retail + Wholesale POS, inventory and accounts management",
  "main": "electron/main.cjs",
  "author": "ShopManager",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit",
    "check": "node --check electron/main.cjs && npm run typecheck",
    "test:accounting": "node scripts/test-accounting.cjs",
    "test:phase0": "node scripts/test-phase0.cjs",
    "test:phaseB": "node scripts/test-phaseB.cjs",
    "test:phaseC": "node scripts/test-phaseC.cjs",
    "test:phaseD": "node scripts/test-phaseD.cjs",
    "test:phaseE": "node scripts/test-phaseE.cjs",
    "test:phaseF": "node scripts/test-phaseF.cjs",
    "test:phaseG": "node scripts/test-phaseG.cjs",
    "test:phaseH": "node scripts/test-phaseH.cjs",
    "test:phaseI": "node scripts/test-phaseI.cjs",
    "test:phaseJ": "node scripts/test-phaseJ.cjs",
    "test:phaseK": "node scripts/test-phaseK.cjs",
    "test:phaseL": "node scripts/test-phaseL.cjs",
    "test:phaseM": "node scripts/test-phaseM.cjs",
    "test:phaseN": "node scripts/test-phaseN.cjs",
    "test:phaseO": "node scripts/test-phaseO.cjs",
    "test:phaseP": "node scripts/test-phaseP.cjs",
    "test:phaseQ": "node scripts/test-phaseQ.cjs",
    "test:phaseR": "node scripts/test-phaseR.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.shopmanager.desktop",
    "productName": "ShopManager",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShopManager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": true
  }
}
