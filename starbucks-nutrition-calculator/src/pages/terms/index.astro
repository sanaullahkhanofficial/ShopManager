---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Terms of Use | Starbucks Nutrition Calculator" description="Terms of use for the Starbucks Nutrition Calculator." path="/terms/">
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Terms of use</h1>
      <p>
        Starbucks Nutrition Calculator is an independent informational tool and is not affiliated with, endorsed by, or sponsored by Starbucks Corporation.
        Nutrition figures are estimates based on available U.S. standard-recipe data and supported customization rules; actual prepared nutrition may vary by
        location, preparation and ingredient availability. This tool is provided for general informational purposes only and is not medical or dietary advice.
        For allergy or medical decisions, refer to current official Starbucks product information.
      </p>
    </div>
  </section>
</BaseLayout>
