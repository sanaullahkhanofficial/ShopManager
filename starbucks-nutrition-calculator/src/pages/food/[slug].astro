---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DATABASE, FOOD_BY_SLUG } from '@/data/us';
import { formatValue } from '@/lib/format';

export function getStaticPaths() {
  return DATABASE.foods.map((food) => ({ params: { slug: food.slug } }));
}

const { slug } = Astro.params;
const food = slug ? FOOD_BY_SLUG[slug] : undefined;

if (!food) {
  return Astro.redirect('/food/');
}

const rows: { label: string; key: keyof typeof food.nutrition; unit: string }[] = [
  { label: 'Calories', key: 'calories', unit: '' },
  { label: 'Total Fat', key: 'totalFatG', unit: 'g' },
  { label: 'Saturated Fat', key: 'saturatedFatG', unit: 'g' },
  { label: 'Trans Fat', key: 'transFatG', unit: 'g' },
  { label: 'Cholesterol', key: 'cholesterolMg', unit: 'mg' },
  { label: 'Sodium', key: 'sodiumMg', unit: 'mg' },
  { label: 'Carbohydrates', key: 'carbohydratesG', unit: 'g' },
  { label: 'Fiber', key: 'fiberG', unit: 'g' },
  { label: 'Sugar', key: 'sugarG', unit: 'g' },
  { label: 'Protein', key: 'proteinG', unit: 'g' },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Food', item: 'https://example.com/food/' },
      { '@type': 'ListItem', position: 2, name: food.name, item: `https://example.com/food/${food.slug}/` },
    ],
  },
];
---

<BaseLayout
  title={`${food.name} Nutrition Facts | Starbucks Nutrition Calculator`}
  description={`Calories, sugar, protein, fat and sodium for a Starbucks ${food.name}.`}
  path={`/food/${food.slug}/`}
  structuredData={structuredData}
>
  <section class="section">
    <div class="container">
      <nav aria-label="Breadcrumb" style="margin-bottom:16px;font-size:0.85rem;">
        <a href="/food/">Food</a> / <span>{food.name}</span>
      </nav>
      <div class="section__heading">
        <p class="section__eyebrow">{food.category}</p>
        <h1>{food.name}</h1>
        <p>{food.description}</p>
      </div>

      <h2>Nutrition Facts &mdash; {food.servingSize}</h2>
      <table style="width:100%;border-collapse:collapse;max-width:480px;">
        <tbody>
          {
            rows.map((row) => (
              <tr style="border-bottom:1px solid var(--color-border);">
                <td style="padding:8px 0;">{row.label}</td>
                <td style="padding:8px 0;text-align:right;font-weight:600;">{formatValue(food.nutrition[row.key], row.unit ? ` ${row.unit}` : '')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      {
        food.ingredients.length > 0 && (
          <p style="margin-top:16px;">
            <strong>Ingredients:</strong> {food.ingredients.join(', ')}.
          </p>
        )
      }
      {
        food.allergens.length > 0 && (
          <p>
            <strong>Contains:</strong> {food.allergens.join(', ')}. Ingredient information only &mdash; refer to current official Starbucks product information
            for allergy or medical decisions.
          </p>
        )
      }

      <p style="margin-top:16px;color:var(--color-ink-500);font-size:0.85rem;">
        Data status: {food.source.status}. {food.source.note}{' '}
        {
          food.source.sourceUrl && (
            <>
              Reference: <a href={food.source.sourceUrl}>{food.source.sourceUrl}</a>.
            </>
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>
