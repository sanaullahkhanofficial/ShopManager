---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy | Starbucks Nutrition Calculator" description="How the Starbucks Nutrition Calculator handles your data." path="/privacy/">
  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Privacy policy</h1>
      <p>
        This site does not require an account and does not run invasive tracking by default. Saved drinks, recent drinks and favorites are stored only in your
        browser&rsquo;s local storage on your own device &mdash; they are not sent to a server. Clearing your browser data or storage will remove them. If
        analytics are added in the future, they will be described here before being enabled.
      </p>
    </div>
  </section>
</BaseLayout>
